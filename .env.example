# Server-side only (used by the /api proxy; never shipped to the browser)
# Subbal Middleware base URL, without /api/v1
#   dev:     https://subbal-api.dev.mbanq.cloud
#   staging: https://subbal-api.crb-s.mbanq.cloud
SUBBAL_API_BASE_URL=https://subbal-api.dev.mbanq.cloud
# Core tenant identifier, sent as the `tenantid` header on every call
SUBBAL_TENANT_ID=default
# OAuth client credentials, added to /oauth/token and /oauth/refresh
SUBBAL_CLIENT_ID=subbal-api
SUBBAL_CLIENT_SECRET=secret@test

# Client-side (optional): prefills the username on the login form
VITE_DEFAULT_USERNAME=poadmin@subbal.com
